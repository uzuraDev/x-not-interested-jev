# Required. Vercel AI Gateway key only — never a TypeSafe direct API key.
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Chrome remote debugging endpoint. Launch Chrome yourself, then connect.
# CDP_URL=http://127.0.0.1:9222

# Safety: default is dry-run. Decisions are logged and Not interested is never clicked.
# Live clicks require the exact value false (case-insensitive). Any other value stays dry-run.
# DRY_RUN=true

# Act only when Jev's probability for "yes" is at least this (0–1). Default 0.85.
# If the response has no probabilities, a clear choice of "yes" is required instead.
# THRESHOLD=0.85

# Stop after this many Not interested clicks (or would-be clicks while dry-run).
# MAX_ACTIONS=20

# Stop after this many posts sent to Jev (followed accounts are skipped and not counted).
# MAX_POSTS=40

# Pause between Jev evaluations, milliseconds, plus the random span between min and max.
# MIN_DELAY_MS=3000
# MAX_DELAY_MS=8000

# Mute and Block are not implemented. These flags do nothing and stay off.
# ENABLE_MUTE=false
# ENABLE_BLOCK=false
